# =================================================================
# BAVIS — Environment Variables & Configuration Template
# Copy this file to .env before running docker-compose up
# =================================================================

# Global Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_DB=bavis
POSTGRES_USER=bavis_admin
POSTGRES_PASSWORD=bavis_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_HOST=redis
REDIS_PORT=6379

# Evidence Storage (S3 / MinIO)
MINIO_ROOT_USER=bavis_minio_admin
MINIO_ROOT_PASSWORD=bavis_minio_secret_key_2026
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=bavis-evidence

# Backend API Service
BACKEND_HOST=backend-api
BACKEND_PORT=8000
JWT_SECRET=bavis_jwt_super_secret_signing_key_sih26187_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ingestion Gateway
INGESTION_HOST=ingestion
INGESTION_PORT=8001
DEFAULT_RTSP_FEED=rtsp://localhost:8554/live/bop_camera_1

# AI / Vision Inference Engine
AI_ENGINE_HOST=ai-engine
AI_ENGINE_PORT=8002
CONFIDENCE_THRESHOLD=0.50

# Intelligence / Risk Engine
INTELLIGENCE_HOST=intelligence
INTELLIGENCE_PORT=8003

# Frontend Dashboard
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080/api/v1

# Reverse Proxy (Nginx)
HTTP_PORT=8080
HTTPS_PORT=8443
